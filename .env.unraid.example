# Container images published by .github/workflows/publish-images.yml.
# Pin a tested release or sha-* tag; do not cut over production on `latest`.
APP_IMAGE_REPOSITORY=ghcr.io/davidabadi/homelab-app
WEB_IMAGE_REPOSITORY=ghcr.io/davidabadi/homelab-web
HOMELAB_VERSION=sha-REPLACE_WITH_TESTED_COMMIT

APP_NAME=Homelab
APP_ENV=production
APP_KEY=base64:copy-the-existing-production-key-verbatim
APP_DEBUG=false
# Keep the installed TV PWA on its existing public HTTPS origin.
APP_URL=https://tvtime.example.com

# Hostnames only (no scheme or path). Cloudflare routes all three hostnames to
# the same Unraid WEB_PORT; Laravel selects the module from the Host header.
TV_HOST=tvtime.example.com
SCHEDULE_HOST=schedule.example.com
PRESENCE_HOST=presence.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

WEB_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=homelab
DB_USERNAME=homelab
DB_PASSWORD=replace-with-a-long-random-password
# Set both flags to false only while initializing and restoring the new
# homelab database as described in docs/production-cutover-unraid.md.
RUN_MIGRATIONS=true
REQUIRE_EXISTING_DATABASE=true
# This is the new homelab stack's PostgreSQL directory. Do not point it at the
# running tracker stack's data directory or share one directory between stacks.
DB_DATA_LOCATION=/mnt/user/appdata/homelab/postgres

# Enable or disable scheduled PostgreSQL dumps.
DB_DUMP_ENABLED=true
# Standard five-part cron expression interpreted in the application timezone.
DB_DUMP_CRON="0 2 * * *"
# Delete completed dumps older than this many days after a successful dump.
DB_DUMP_RETENTION_DAYS=7
# Host folder where database dumps are stored.
# On Unraid, use a persistent share such as /mnt/user/backups/homelab.
DB_DUMP_PATH=/mnt/user/backups/homelab

SESSION_DRIVER=database
SESSION_LIFETIME=5256000
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
# Copy the tracker stack's current cookie name so installed clients can keep
# their session after the restored database and APP_KEY move to this stack.
SESSION_COOKIE=copy-existing-production-cookie-name-verbatim
# Preserve the current production value through cutover. Use the shared parent
# domain only if cross-subdomain login is intentionally required.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Get a v3 API key from https://www.themoviedb.org/settings/api.
TMDB_API_KEY=replace-with-your-tmdb-v3-api-key

VITE_APP_NAME="${APP_NAME}"
